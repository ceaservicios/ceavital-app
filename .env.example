PORT=8443
NODE_ENV=development

# Base de datos PostgreSQL (obligatoria). En Easypanel usar el nombre interno del
# servicio de Postgres, ej.: postgres://usuario:clave@ceavital_ceavital-bd:5432/ceavital?sslmode=disable
DATABASE_URL=
# Maximo de conexiones del pool (opcional, default 10).
# DB_POOL_MAX=10

# Lista separada por comas de origenes permitidos por CORS (solo hace falta en
# desarrollo, cuando el frontend corre en otro puerto/dispositivo). Vacio =
# sin CORS, valido para produccion donde el mismo Express sirve el frontend.
ALLOWED_ORIGINS=

# 'selfsigned' (default, solo para desarrollo en la propia PC) o 'proxy' (VPS
# detras de un reverse proxy que ya termina TLS con un dominio real, ej.
# Easypanel/Traefik). En VPS:
# PORT=3000, NODE_ENV=production, HTTPS_MODE=proxy (ver Dockerfile).
HTTPS_MODE=selfsigned

# Los módulos activos (portal, pedidos, etc.) dependen del plan de la instalación, que
# elige el superadmin desde /sa (ver src/config/modulos.js). No es una variable.

# Superadmin de CEA (panel /sa, EST-01): entra con su mail por el mismo login de todos.
# La contrasena solo se usa para CREAR la cuenta la primera vez que arranca la
# instalacion; despues manda la guardada (no esta variable). De 12 a 72 caracteres.
# Sin SUPERADMIN_EMAIL y SUPERADMIN_PASSWORD el panel no admite ingresos. Cambiar el
# mail en una instalacion que ya tiene cuenta la renombra y cierra sus sesiones.
# Para cambiar la contrasena: SUPERADMIN_PASSWORD_NUEVA=... npm run reset-superadmin-password
# (desde la terminal del servidor, nunca por argumento). Si pierde su segundo paso:
# npm run restablecer-2fa-superadmin (al entrar lo vuelve a configurar).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Verificacion en dos pasos (obligatoria para el superadmin y los Admin del negocio).
# DOSFA_CLAVE cifra los secretos de las apps autenticadoras: 32 caracteres o mas, al azar.
# Si se cambia, quienes usan la app la tienen que volver a configurar (el superadmin les
# restablece el 2FA). Sin ella solo se puede elegir el codigo por mail.
DOSFA_CLAVE=
# Nombre que muestra la app autenticadora (distingue esta instalacion de otras de CEAVital).
DOSFA_EMISOR=CEAVital
# Version que muestra el panel (opcional; si no, la del package.json).
# APP_VERSION=

# Correo de CEA (admin@ceavital.net): avisos de cuota, alertas de seguridad y los
# codigos del 2FA por mail del superadmin.
# Aparte de SMTP_* de abajo, que es el correo de la empresa para escribirle a sus
# clientes: en un clon, SMTP_* pasa a ser de la empresa y los avisos de CEA tienen que
# seguir saliendo con la identidad de CEA. Sin SA_SMTP_HOST no se manda ningun aviso
# (el panel /sa lo indica). Las credenciales van en el entorno del servidor, nunca en el repo.
SA_SMTP_HOST=
SA_SMTP_PORT=587
SA_SMTP_USER=
SA_SMTP_PASS=
# Remitente, ej. CEA Servicios <admin@ceavital.net>
SA_SMTP_FROM=
# AVISOS_CUOTA=off apaga la revision automatica de cuotas.

# URL publica del sistema. NECESARIA para las copias a Google Drive y la
# restauracion desde /sa: de su dominio salen la carpeta y el nombre de las
# copias; vacia = no hay copias diarias ni restauracion (el panel /sa lo indica).
# Tambien arma los enlaces de los mails (portal del cliente, Administradores);
# para eso, vacia = se deduce del dominio con el que se usa el sistema.
# Ejemplo: PUBLIC_URL=https://app.ceavital.net
PUBLIC_URL=

# Correo de la empresa (un buzon por empresa que crea y maneja CEA). Por aca salen
# los codigos de ingreso de los usuarios del negocio (verificacion del email y 2FA),
# la contrasena provisoria de los Administradores y los datos de acceso al portal.
# La app funciona sin el (EST-01 10.2): la verificacion del email queda en pausa, el
# 2FA de los Administradores va por app, la contrasena provisoria se ve en pantalla y
# la ficha del cliente ofrece abrir el mail en el programa de correo de quien lo usa.
# Lo unico que no se puede es activar el 2FA por mail. Puerto 587 = STARTTLS, 465 =
# conexion segura desde el inicio. Con Gmail hace falta una "contrasena de
# aplicacion" (no la clave normal). Las credenciales van en el entorno del
# servidor (Easypanel), nunca en el repo. Si esta casilla es tambien el mail de un
# Administrador, lo que el sistema le manda a esa misma casilla sale por el correo de CEA
# (SA_SMTP_*): Gmail no deja en Recibidos un mail que una casilla se manda a si misma.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente que ve el cliente, ej. CEAVital <no-responder@ceavital.net>. Conviene un alias de la
# cuenta de CEA (configurado en Gmail > "Enviar correo como"), no la casilla de la empresa.
SMTP_FROM=

# A donde van las respuestas a esos mails: la casilla propia de la empresa (opcional; vacio =
# al remitente). Ej. SMTP_REPLY_TO=empresa@ceavital.net
# SMTP_REPLY_TO=

# Copias de seguridad de la base (panel /sa > Copias): una automatica por dia desde las 3
# (hora argentina) al Google Drive de CEA (admin@ceaservicios.com.ar), carpeta
# "Copias CEAVital/<dominio de PUBLIC_URL>/", 30 dias. Mismo cliente OAuth que IntelDrive y
# DaleFit (permiso drive.file). Sin estas tres variables, o sin PUBLIC_URL, no hay copias.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# Defensa activa por IP (bloqueo automatico de atacantes, ver el panel /sa > Seguridad).
# A donde llega el mail de cada bloqueo (sale por el correo de CEA, SA_SMTP_*):
DEFENSA_IP_ALERTA_EMAIL=
# IPs que nunca se bloquean, separadas por coma (ej. la de la oficina de CEA):
DEFENSA_IP_PERMITIDAS=
# DEFENSA_IP=off apaga la defensa (solo diagnostico).
