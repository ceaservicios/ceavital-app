PORT=8443
NODE_ENV=development

# Base de datos PostgreSQL (obligatoria). En Easypanel usar el nombre interno del
# servicio de Postgres, ej.: postgres://usuario:clave@ceavital_ceavital-bd:5432/ceavital?sslmode=disable
DATABASE_URL=
# Maximo de conexiones del pool (opcional, default 10).
# DB_POOL_MAX=10

# Pase a produccion desde SQLite (opcional, una sola vez): ruta del archivo
# ceavital.db de la epoca anterior. Al arrancar, si PostgreSQL esta vacio, importa
# todos los datos (verifica cantidades y sumas de dinero antes de confirmar). Si
# PostgreSQL ya tiene datos no hace nada. No modifica el archivo SQLite.
# IMPORTAR_SQLITE=/data/ceavital.db

# Lista separada por comas de origenes permitidos por CORS (solo hace falta en
# desarrollo, cuando el frontend corre en otro puerto/dispositivo). Vacio =
# sin CORS, valido para produccion donde el mismo Express sirve el frontend.
ALLOWED_ORIGINS=

# 'selfsigned' (default, instalacion LAN) o 'proxy' (VPS detras de un reverse
# proxy que ya termina TLS con un dominio real, ej. Easypanel/Traefik). En VPS:
# PORT=3000, NODE_ENV=production, HTTPS_MODE=proxy (ver Dockerfile).
HTTPS_MODE=selfsigned

# Los módulos activos (portal, pedidos, etc.) dependen del plan de la instalación,
# que se fija con: npm run set-plan -- <plan>  (ver src/config/modulos.js).

# Superadmin de CEA (panel /sa). Solo se usan para CREAR la cuenta la primera vez que
# arranca la instalacion; despues manda la contrasena guardada (no esta variable).
# Contrasena de 12 a 72 caracteres. Sin SUPERADMIN_PASSWORD el panel no admite
# ingresos. Para cambiarla mas adelante: SUPERADMIN_PASSWORD_NUEVA=... npm run
# reset-superadmin-password (desde la terminal del servidor). Nunca por argumento.
SUPERADMIN_USUARIO=superadmin
SUPERADMIN_PASSWORD=
# Version que muestra el panel (opcional; si no, la del package.json).
# APP_VERSION=

# URL publica del sistema, para el enlace del portal en los mails al cliente.
# Vacio = se deduce del dominio con el que se usa el sistema (en VPS funciona
# solo). Ejemplo: PUBLIC_URL=https://app.ceavital.net
PUBLIC_URL=

# Envio de mails con los datos de acceso al portal (OPCIONAL, usa internet).
# Sin SMTP_HOST el sistema anda igual y la ficha del cliente ofrece abrir el
# mail en el programa de correo de quien lo usa. Puerto 587 = STARTTLS, 465 =
# conexion segura desde el inicio. Con Gmail hace falta una "contrasena de
# aplicacion" (no la clave normal). Las credenciales van en el entorno del
# servidor (Easypanel), nunca en el repo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente que ve el cliente, ej. CEAVital <no-responder@ceavital.net>
SMTP_FROM=
